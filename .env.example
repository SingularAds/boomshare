# Boomshare AI Backend - configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value below can also be supplied as a real environment variable, which
# is what you should do in staging and production (use your platform's secret
# store, not a file).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local           # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true               # false gives human-readable logs for local work

# ---------------------------------------------------------------------------
# PostgreSQL - the source of truth
# ---------------------------------------------------------------------------
# Local / TCP:
DATABASE_URL=postgresql+asyncpg://boomshare:boomshare@localhost:5432/boomshare
# GCP Cloud SQL over the Unix socket (Cloud Run mounts it with
# --add-cloudsql-instances). URL-encode the password: @ -> %40.
#   postgresql+asyncpg://USER:PW@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis - cache, locks, rate limits, job queue. Never durable storage.
# Sized for a 30MB free tier: everything written has a TTL.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
# ---------------------------------------------------------------------------
# App secret: Meta App -> Settings -> Basic -> App Secret.
# Used to verify the X-Hub-Signature-256 on every webhook delivery.
META_APP_SECRET=

# Verify token: any string you choose. You type the same value into the
# webhook configuration screen in the Meta dashboard.
META_VERIFY_TOKEN=

# System user access token with whatsapp_business_messaging,
# whatsapp_business_management, leads_retrieval and pages_manage_ads.
META_ACCESS_TOKEN=

META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# WhatsApp Manager -> API Setup -> Phone number ID (NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=

# Approved message templates. Both must exist and be APPROVED in WhatsApp
# Manager before they can be sent, and both take one body parameter: {{1}} is
# the customer's first name.
WHATSAPP_LEAD_TEMPLATE_NAME=boomshare_lead_intro
WHATSAPP_LEAD_TEMPLATE_LANGUAGE=en
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=boomshare_followup
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0.6
OPENAI_MAX_OUTPUT_TOKENS=700

# ---------------------------------------------------------------------------
# Internal API
# ---------------------------------------------------------------------------
# Shared secret for /internal/* (the Boomshare desktop backend reporting
# installs) and /admin/* (operator tooling). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Product
# ---------------------------------------------------------------------------
# Tracked download links are built as {DOWNLOAD_BASE_URL}?ref={token}
DOWNLOAD_BASE_URL=https://boomshare.ai/download
MAX_REPLY_CHARACTERS=900

# ---------------------------------------------------------------------------
# Conversation policy
# ---------------------------------------------------------------------------
# Meta's customer service window. Do not raise this above 24.
SERVICE_WINDOW_HOURS=24
HISTORY_MESSAGE_LIMIT=20
AI_REPLY_LOCK_SECONDS=30
INBOUND_RATE_LIMIT_PER_MINUTE=20
# Automatic check-in when a live conversation ends a turn with nothing queued,
# so a warm lead is never lost to silence. Keep this below
# SERVICE_WINDOW_HOURS: inside the window the follow-up can be a normal AI
# message instead of an approved template.
DEFAULT_FOLLOW_UP_HOURS=20

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
WORKER_QUEUE_NAME=boomshare:jobs
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=5
# Keep well above one reply turn's worst case (OpenAI timeout x retries + Meta
# retries) so the sweeper never re-enqueues a job that is still running.
WEBHOOK_SWEEP_AFTER_SECONDS=180
SCHEDULER_INTERVAL_SECONDS=15
