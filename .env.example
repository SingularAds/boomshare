# Boomshare AI Backend - configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value below can also be supplied as a real environment variable, which
# is what you should do in staging and production (use your platform's secret
# store, not a file).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local           # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true               # false gives human-readable logs for local work

# ---------------------------------------------------------------------------
# PostgreSQL - the source of truth
# ---------------------------------------------------------------------------
# Local / TCP:
DATABASE_URL=postgresql+asyncpg://boomshare:boomshare@localhost:5432/boomshare
# GCP Cloud SQL over the Unix socket (Cloud Run mounts it with
# --add-cloudsql-instances). URL-encode the password: @ -> %40.
#   postgresql+asyncpg://USER:PW@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis - cache, locks, rate limits, job queue. Never durable storage.
# Sized for a 30MB free tier: everything written has a TTL.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
# ---------------------------------------------------------------------------
# App secret: Meta App -> Settings -> Basic -> App Secret.
# Used to verify the X-Hub-Signature-256 on every webhook delivery.
META_APP_SECRET=

# Verify token: any string you choose. You type the same value into the
# webhook configuration screen in the Meta dashboard.
META_VERIFY_TOKEN=

# System user access token with whatsapp_business_messaging,
# whatsapp_business_management, leads_retrieval and pages_manage_ads.
META_ACCESS_TOKEN=

META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# WhatsApp Manager -> API Setup -> Phone number ID (NOT the phone number).
# One entry per number this deployment answers on. They all arrive at the same
# webhook, so adding a number here is all that is needed to start handling it.
# The FIRST entry is the default sender: it is used only where there is no
# incoming message to answer, which today means lead-ad outreach. Replies and
# follow-ups always go out from the number the conversation is already on.
# Shape: # Optional. What to call each number above in the dashboard, since Meta
# gives us an opaque id. Falls back to "Number 1"/"Number 2" if unset.
# WHATSAPP_NUMBER_LABELS={"1271448969390854":"+55 11 90000-0000"}
# WHATSAPP_NUMBER_LABELS=   (JSON - must stay commented out when unused, not left blank)
# Optional. The team's own phones, used to exercise the live pipeline.
# They behave like any other customer everywhere except the dashboard,
# which hides them unless "Real customers only" is unticked.
# TEST_PHONE_NUMBERS=["+91 99052 52720"]
# TEST_PHONE_NUMBERS=   (JSON - must stay commented out when unused, not left blank)
WHATSAPP_PHONE_NUMBER_IDS=["111111111111111", "222222222222222"]
WHATSAPP_PHONE_NUMBER_IDS=[]

# Approved message templates. Both must exist and be APPROVED in WhatsApp
# Manager before they can be sent, and both take one body parameter: {{1}} is
# the customer's first name.
WHATSAPP_LEAD_TEMPLATE_NAME=boomshare_lead_intro
WHATSAPP_LEAD_TEMPLATE_LANGUAGE=en
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=boomshare_followup
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0.6
OPENAI_MAX_OUTPUT_TOKENS=700

# ---------------------------------------------------------------------------
# Internal API
# ---------------------------------------------------------------------------
# Shared secret for /internal/* (the Boomshare desktop backend reporting
# installs) and /admin/* (operator tooling). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
ADMIN_API_TOKEN=
# Read-only token for the dashboard viewer. Accepts overview, customer list,
# and customer detail. Cannot send messages, wipe data, or touch conversations.
# Share this with operators; keep ADMIN_API_TOKEN strictly internal.
# When blank, the dashboard falls back to accepting ADMIN_API_TOKEN only.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=

# ---------------------------------------------------------------------------
# Product
# ---------------------------------------------------------------------------
# Tracked download links are built as {DOWNLOAD_BASE_URL}?ref={token}
DOWNLOAD_BASE_URL=https://boomshare.ai/download
MAX_REPLY_CHARACTERS=900

# ---------------------------------------------------------------------------
# Conversation policy
# ---------------------------------------------------------------------------
# Meta's customer service window. Do not raise this above 24.
SERVICE_WINDOW_HOURS=24
HISTORY_MESSAGE_LIMIT=20
# The full international phone number determines the country automatically.
# English is ONLY the fallback when country/language detection is unavailable.
DEFAULT_CONVERSATION_LANGUAGE=en
# ISO country -> language tag. +34 Spain -> es-ES; +351 Portugal -> pt-PT;
# +55 Brazil -> pt-BR. Other countries use their automatic language defaults.
# This map is optional; {} also enables automatic country-language selection.
# Explicit customer language requests take priority over country defaults.
# An entry is a market decision that overrules the automatic one: +91 defaults
# to hi-IN, and "IN":"en-IN" is how you say this business answers it in English.
COUNTRY_LANGUAGE_OVERRIDES={"IN":"en-IN","ES":"es-ES","PT":"pt-PT","BR":"pt-BR"}
# Set only variants already approved in Meta, by template name and locale.
# Matched on the exact locale first, then the base language - so one approved
# "pt":"pt_BR" serves Brazil and Portugal, and one "es":"es" every Spanish
# market. A language with no entry uses the template's own configured language
# (English below), because an unapproved language code is Meta error 132001.
# Leave {} until you have approved translations; ordinary AI replies are
# unaffected and always use the customer's own language.
WHATSAPP_TEMPLATE_LANGUAGES='{"boomshare_lead_intro":{"pt":"pt_BR","es":"es","en":"en"},"boomshare_followup":{"pt":"pt_BR","es":"es","en":"en"}}'
# The approved body of each template, per language, copied from WhatsApp
# Manager with its {{n}} placeholders left in. Meta owns this wording - it is
# what the customer is actually shown - and this is the only way we can store a
# sent template as the words that were delivered rather than as its name. The
# AI reads its own outbound history back from there, so an entry that does not
# match Meta word for word has it answering for something it never said.
WHATSAPP_TEMPLATE_BODIES='{"boomshare_lead_intro":{"pt_BR":"Olá {{1}}, obrigado pelo seu interesse no Boomshare! Fico feliz em tirar qualquer dúvida — o que fez você se interessar por ele?","es":"¡Hola {{1}}! Gracias por tu interés en Boomshare. Con gusto respondo cualquier duda. ¿Qué te llevó a buscar una herramienta como esta?","en":"Hi {{1}}, thanks for your interest in Boomshare! Happy to answer any questions - what made you look into it?"},"boomshare_followup":{"pt_BR":"Olá {{1}}, só passando para saber sobre o Boomshare. Ainda tem interesse? Fico feliz em ajudar quando for melhor para você.","es":"Hola {{1}}, solo paso para ver qué tal con Boomshare. ¿Sigues interesado? Con gusto te ayudo cuando te convenga.","en":"Hi {{1}}, just checking in about Boomshare. Still interested? Happy to help whenever suits."}}'
AI_REPLY_LOCK_SECONDS=30
# How long a turn waits for another worker that is already answering this
# conversation, before giving up. Giving up parks the job and leaves the answer
# until the next sweep, so a customer who sends two messages in a row waits
# WEBHOOK_SWEEP_AFTER_SECONDS for the second reply. Keep it below
# AI_REPLY_LOCK_SECONDS so a lock whose holder died is cleared by its TTL.
AI_REPLY_LOCK_WAIT_SECONDS=20
INBOUND_RATE_LIMIT_PER_MINUTE=20
# Automatic check-ins when a live conversation ends a turn with nothing queued,
# so a warm lead is never lost to silence. One entry per unanswered nudge, in
# hours - and the length of the list is the cap, after which we stop messaging
# a customer who has gone quiet. An empty list turns automatic check-ins off.
#
# Each gap runs from the check-in before it, so it is the running total against
# SERVICE_WINDOW_HOURS that decides how a nudge is sent: 4h is inside the
# window and goes as an ordinary AI message, 4+22=26h and 4+22+72=98h are past
# it and go as the approved template. Keep the first gap below
# SERVICE_WINDOW_HOURS - the application refuses to start otherwise - and keep
# the later totals clear of it rather than on it, or a few seconds of scheduler
# jitter decides whether a customer gets a written reply or a template.
FOLLOW_UP_LADDER_HOURS=[4, 22, 72]

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
WORKER_QUEUE_NAME=boomshare:jobs
# How many jobs one worker runs at a time. A turn is almost all waiting - on
# OpenAI, on the Graph API, on the database - so running them one at a time left
# every customer queued behind someone else's model call. Replies to the same
# conversation still serialise on the Redis lock. Keep at or below DB_POOL_SIZE.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=5
# Keep well above one reply turn's worst case (OpenAI timeout x retries + Meta
# retries) so the sweeper never re-enqueues a job that is still running.
WEBHOOK_SWEEP_AFTER_SECONDS=180
SCHEDULER_INTERVAL_SECONDS=15
